# ─── CreatorFlow AI — Environment Variables ─────────────────────────────────
# Copy this file to .env.local and fill in your values.
#
#   cp .env.example .env.local
#
# Values marked [REQUIRED for live mode] are only needed when DEMO_MODE=false.
# If you just want to explore the UI, set DEMO_MODE=true and skip everything else.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Demo Mode ───────────────────────────────────────────────────────────────
# Set to true to run the full app with rich mock data — no API keys needed.
DEMO_MODE=true
NEXT_PUBLIC_DEMO_MODE=true

# ─── Google Gemini AI [REQUIRED for live mode] ───────────────────────────────
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ─── MongoDB Atlas [REQUIRED for live mode] ──────────────────────────────────
# Get your connection string from: https://cloud.mongodb.com
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>
MONGODB_URI=

# ─── YouTube Data API v3 [REQUIRED for live mode] ────────────────────────────
# Enable the YouTube Data API v3 in Google Cloud Console:
# https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_API_KEY=

# ─── Google OAuth [REQUIRED for live mode] ───────────────────────────────────
# Create OAuth 2.0 credentials at: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── NextAuth ─────────────────────────────────────────────────────────────────
# The public URL of your app (no trailing slash)
NEXTAUTH_URL=http://localhost:3000

# A random secret for signing JWT tokens — generate with:
#   openssl rand -base64 32
NEXTAUTH_SECRET=
